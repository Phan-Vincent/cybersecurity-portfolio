# configs/auditd.conf.hardening — values to set in /etc/audit/auditd.conf
# Matches AUDIT-03/AUDIT-04 in lib/auditd.sh. keep_logs never overwrites
# audit history (HIPAA 164.312(b) audit controls; 164.316 six-year retention).
max_log_file = 50
max_log_file_action = keep_logs
space_left_action = email
admin_space_left_action = halt
